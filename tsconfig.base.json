{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@clear-budget/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@clear-budget/shared/ui/*": ["libs/shared/ui/src/*"],
      "@clear-budget/shared/auth": ["libs/shared/auth/src/index.ts"],
      "@clear-budget/shared/auth/*": ["libs/shared/auth/src/*"],
      "@clear-budget/shared/api": ["libs/shared/api/src/index.ts"],
      "@clear-budget/shared/api/*": ["libs/shared/api/src/*"],
      "@clear-budget/shared/models": ["libs/shared/models/src/index.ts"],
      "@clear-budget/shared/models/*": ["libs/shared/models/src/*"]
    },
    "customConditions": ["development"]
  }
}
